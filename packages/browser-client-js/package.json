{
  "name": "@graphmemory/browser-client",
  "version": "0.1.0",
  "description": "Tiny dependency-free client for the browser-mcp stateless REST API (/api/v1).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "gen": "openapi-typescript ../../apps/browser-mcp/openapi.json -o src/generated/openapi.ts",
    "prepublishOnly": "npm run build",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "browser-mcp",
    "browser",
    "automation",
    "playwright",
    "rest",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graph-memory/browser-mcp.git",
    "directory": "packages/browser-client-js"
  },
  "license": "Elastic-2.0",
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
