{
  "name": "browser-mcp-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "//postinstall": "npm does not run a workspace package's postinstall on root install (only `prepare`), so mirror the app's Chromium install here for `git clone && npm install`. CI/Docker use `npm ci --ignore-scripts` and skip this.",
    "postinstall": "npx playwright install chromium",
    "dev": "npm run dev -w @graphmemory/browser-mcp",
    "build": "npm run build -w @graphmemory/browser-mcp",
    "start": "npm run start -w @graphmemory/browser-mcp",
    "test": "npm run test -w @graphmemory/browser-mcp",
    "test:watch": "npm run test:watch -w @graphmemory/browser-mcp",
    "test:coverage": "npm run test:coverage -w @graphmemory/browser-mcp",
    "test:integration": "npm run test:integration -w @graphmemory/browser-mcp"
  }
}
